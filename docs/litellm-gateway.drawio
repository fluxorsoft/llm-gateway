ticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1650" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c72" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Join.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A team adds one file: owner, project, residency, models, budget, limits.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="950" height="40" as="geometry"/></mxCell><mxCell id="c73" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Review.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The central team and the project&amp;#x27;s owner approve; the plan checks the rules.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1145" width="950" height="40" as="geometry"/></mxCell><mxCell id="c74" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Use.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The app reads its key from its own project and calls the shared address.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1105" width="950" height="40" as="geometry"/></mxCell><mxCell id="c75" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Pay.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Model usage is on the team&amp;#x27;s own bill; the gateway&amp;#x27;s record shows it by team.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1145" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3 Configure and onboard" name="3 Configure and onboard"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1120" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;What the central team chooses, and what happens with it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;Everything is a reviewed file in one repository. Names and values are examples.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CHOOSE (REVIEWED FILES)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="560" height="900" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;1. platform: size and regions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;regions&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp;europe-west2,&amp;nbsp;europe-west1&lt;br&gt;size&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp;{db_tier,&amp;nbsp;db_regional,&amp;nbsp;redis_ha,&amp;nbsp;...}&lt;br&gt;usage_bigquery&amp;nbsp;=&amp;nbsp;true&lt;br&gt;drift_check&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp;true&lt;br&gt;alert_email&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;=&amp;nbsp;&amp;quot;llm-team@example.com&amp;quot;&lt;br&gt;admin_members&amp;nbsp;&amp;nbsp;=&amp;nbsp;[group]&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="520" height="200" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px"&gt;2. catalogue: models and rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;gemini-3.5-flash:&lt;br&gt;&amp;nbsp;&amp;nbsp;locations:&amp;nbsp;[eu,&amp;nbsp;global]&lt;br&gt;&amp;nbsp;&amp;nbsp;review_by:&amp;nbsp;2027-02-01&lt;br&gt;&amp;nbsp;&amp;nbsp;timeout_seconds:&amp;nbsp;45&lt;br&gt;residency:&lt;br&gt;&amp;nbsp;&amp;nbsp;eu:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{locations:&amp;nbsp;[eu]}&lt;br&gt;&amp;nbsp;&amp;nbsp;eu-then-global:&amp;nbsp;{locations:&amp;nbsp;[eu,&amp;nbsp;global],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;approved_teams:&amp;nbsp;[support]}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="520" height="245" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;3. teams/support: one file per team&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;owner:&amp;nbsp;support-leads@example.com&lt;br&gt;project:&amp;nbsp;support-project-id&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;used&amp;nbsp;and&amp;nbsp;billed&lt;br&gt;residency:&amp;nbsp;eu-then-global&lt;br&gt;models:&lt;br&gt;&amp;nbsp;&amp;nbsp;chat:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;model:&amp;nbsp;gemini-3.5-flash&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;locations:&amp;nbsp;[eu,&amp;nbsp;global]&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;in&amp;nbsp;this&amp;nbsp;order&lt;br&gt;budget_monthly_usd:&amp;nbsp;10&lt;br&gt;limits:&amp;nbsp;{rpm:&amp;nbsp;60,&amp;nbsp;tpm:&amp;nbsp;100000}&lt;br&gt;keys:&amp;nbsp;[1]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;add&amp;nbsp;2&amp;nbsp;to&amp;nbsp;rotate&lt;br&gt;key_days:&amp;nbsp;30&lt;br&gt;app_service_account:&amp;nbsp;llm-app&lt;br&gt;network:&amp;nbsp;{region,&amp;nbsp;cidr}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="520" height="370" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CHECK (THE PLAN STOPS)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="330" height="900" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;Model not in the catalogue&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;or past its review date&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="125" width="280" height="98" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:12px"&gt;Location outside the residency&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;including any failover&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="245" width="280" height="98" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:12px"&gt;Model not offered there&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;from the catalogue&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="365" width="280" height="98" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:12px"&gt;Residency not approved&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;for this team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="485" width="280" height="98" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;Project used twice&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one project, one team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="605" width="280" height="98" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;No owner, budget or limits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;or above the maximum&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="725" width="280" height="98" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;LiteLLM changed by hand&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a daily plan finds it; an alert&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="845" width="280" height="98" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:12px;color:#5F6368"&gt;APPLY (GITHUB ACTIONS)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="480" height="900" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:12px&quot;&gt;Verify and build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;LiteLLM's signature; open source parts only; by digest&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="120" width="430" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:15px&quot;&gt;Step 1: Google&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;applied by GitHub's identity&lt;/span&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="220" width="430" height="330" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;Platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;network, gateways, database, Model Armor, alerts&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="275" width="380" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:12px&quot;&gt;Predict-only grant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;for the gateway, in the team's project&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="357" width="380" height="72" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:12px&quot;&gt;Secret, app identity, network&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;in the team's project; peered to the gateway&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="439" width="380" height="92" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:15px"&gt;Step 2: LiteLLM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;applied by the runner, inside the network&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="570" width="430" height="390" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b style="font-size:12px"&gt;Models&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one per team, model and location, with an order&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="625" width="380" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fallback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;the team's other model&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="707" width="380" height="72" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;Team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;allowed models, budget, limits&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="789" width="380" height="72" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:12px"&gt;Key&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;to LiteLLM and the secret; never in state&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="871" width="380" height="72" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px;color:#5F6368"&gt;USE (THE APP TEAM)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#E6F4F1;strokeColor=#0B6B67;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1580" y="80" width="400" height="900" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b style="font-size:12px"&gt;Address&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;https://llm.internal.example.com&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="125" width="350" height="90" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b style="font-size:12px"&gt;Model name&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;support-chat&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="235" width="350" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;font-size:12px&quot;&gt;Key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;from its own project's secr