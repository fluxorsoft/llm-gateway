nt-size:11px;color:#5F6368"&gt;the app is refused if it calls&lt;br&gt;the model API directly&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1620" y="545" width="320" height="85" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1780" y="305" as="sourcePoint"/><mxPoint x="1780" y="275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value='&lt;b style="font-size:15px"&gt;The gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;https://llm.internal.example.com&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F4FBFA;strokeColor=#0B6B67;strokeWidth=1.8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="1010" height="560" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;POST /v1/chat/completions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;the same address, path and request shape for every team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="770" height="70" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:12px"&gt;Who is it?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;the key names&lt;br&gt;the team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F