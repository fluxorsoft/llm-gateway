&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="288" width="740" height="66" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="321" as="sourcePoint"/><mxPoint x="1200" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="321" as="sourcePoint"/><mxPoint x="540" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="270" as="sourcePoint"/><mxPoint x="270" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;Agent identity&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;the filter, for an ID token&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="372" width="420" height="66" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:12px&quot;&gt;ve