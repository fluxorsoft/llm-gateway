FFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="825" as="sourcePoint"/><mxPoint x="1200" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="825" as="sourcePoint"/><mxPoint x="540" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="774" as="sourcePoint"/><mxPoint x="270" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value='&lt;b style="font-size:12px"&gt;Usage record&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;team, project, location, tokens, cost&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="876" width="420" height="66" as="geometry"/></mxCell><mxCell id="c59" value='&lt;b style="font-size:12px"&gt;to logs and BigQuery&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="876" width="600" height="66" as="geometry"/></mxCell><mxCell id="c60" value='&lt;b style="font-size:12px"&gt;never the prompt or the answer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="876" width="740" height="66" as="geometry"/></mxCell><mxCell id="c61" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="909" as="sourcePoint"/><mxPoint x="1200" y="909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="909" as="sourcePoint"/><mxPoint x="540" y="909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="858" as="sourcePoint"/><mxPoint x="270" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why a filter in front.&lt;/b&gt; &lt;span style="font-size:12px"&gt;LiteLLM before 1.111.0 accepts a project and a location from the caller.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="950" height="44" as="geometry"/></mxCell><mxCell id="c65" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why not a hook.&lt;/b&gt; &lt;span style="font-size:12px"&gt;LiteLLM changes the request before a hook sees it.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1039" width="950" height="44" as="geometry"/></mxCell><mxCell id="c66" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why hold a stream.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Text already sent cannot be taken back; the app gets the checked answer at once.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="995" width="950" height="44" as="geometry"/></mxCell><mxCell id="c67" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why no prompt logs.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The record is for cost and faults; prompts can hold personal data.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1039" width="950" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5 Failover" name="5 Failover"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1150" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;When something is down&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;Two separate failovers, and what was measured on the real deployment.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;THE GATEWAY'S REGION&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="620" height="640" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;Region A&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;readiness fails&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="163.0" y="139" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;Region B&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;takes the traffic&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="250" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="473.0" y="139" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#188038;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="190" as="sourcePoint"/><mxPoint x="370" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Measured:&lt;/b&gt; the database was restarted (35 seconds) with region A barred from it. Traffic moved to region B and back; &lt;b&gt;1 of 379 calls failed&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;A bad release&lt;/b&gt; cannot do this: a revision that is not ready never gets traffic.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not covered:&lt;/b&gt; the database itself. There is one; while it is down, keys cannot be checked and calls are refused.&lt;br&gt;&lt;br&gt;&lt;b&gt;Coupling to know:&lt;/b&gt; a region outside the EU reaches the eu location through the EU region. For EU residency that survives a region, use two EU regions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Limits&lt;/b&gt; are counted in each region's Redis, so 60 a minute can allow 120 across two.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="560" height="430" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;THE MODEL'S LOCATION (CHOSEN PER TEAM)&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="1300" height="640" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:13px"&gt;EU only&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="164" width="160" height="40" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="270" height="92" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;Then&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.8-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="130" width="270" height="92" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="130" width="220" height="92" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="176" as="sourcePoint"/><mxPoint x="1230" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="176" as="sourcePoint"/><mxPoint x="1590" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value='&lt;b style="font-size:13px"&gt;EU, then global&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="279" width="160" height="40" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="245" width="270" height="92" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:12px"&gt;Then&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;global&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="245" width="270" height="92" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="245" width="220" height="92" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="291" as="sourcePoint"/><mxPoint x="1230" y="291" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="291" as="sourcePoint"/><mxPoint x="1590" y="291" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value='&lt;b style="font-size:13px"&gt;UK only&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="394" width="160" height="40" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;europe-west2&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="360" width="270" height="92" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:12px"&gt;None&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;no second UK location&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="360" width="270" height="92" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="360" width="220" height="92" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="406" as="sourcePoint"/><mxPoint x="1230" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="406" as="sourcePoint"/><mxPoint x="1590" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Measured:&lt;/b&gt; the eu location was cut off. The support team was served from global; the orders team got an error and &lt;b&gt;never left the EU&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;The first call waits&lt;/b&gt; for the model's time limit (45 seconds), then the location rests for two minutes and calls are quick. Set the app's own time limit above that.&lt;br&gt;&lt;br&gt;&lt;b&gt;The alert&lt;/b&gt; opened about four minutes after the first failure.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="490" width="1250" height="220" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT AN APP STILL HANDLES&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1950" height="150" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b style="font-size:12px"&gt;A stream that breaks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;an error event arrives: the answer&lt;br&gt;is incomplete&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="440" height="90" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;429 and 5xx&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;wait and retry; stop on&lt;br&gt;a budget error&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="790" width="440" height="90" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b style="font-size:12px"&gt;A blocked prompt&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;show the reason; do not retry&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="790" width="440" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&quot;font-size:12px&quot;&gt;Time&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;longer than the gateway's failover&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="790" width="440" height="90" as="geometry"/></mxCell><mxCell id="c35" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Try.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The first location.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="950" height="40" as="geometry"/></mxCell><mxCell id="c36" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Rest.&lt;/b&gt; &lt;span style="font-size:12px"&gt;One time-out, or two errors, takes it out for two minutes.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="950" height="40" as="geometry"/></mxCell><mxCell id="c37" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Move.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The next location, then the team&amp;#x27;s other model, inside its residency.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="925" width="950" height="40" as="geometry"/></mxCell><mxCell id="c38" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Tell.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The response shows the fallbacks; an alert tells the central team.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="965" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
