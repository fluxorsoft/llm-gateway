tml=1;rounded=0;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="1303" y="895" as="sourcePoint"/><mxPoint x="385" y="585" as="targetPoint"/><Array as="points"><mxPoint x="1303" y="850"/><mxPoint x="320" y="850"/><mxPoint x="320" y="585"/></Array></mxGeometry></mxCell><mxCell id="c90" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Provision.&lt;/b&gt; &lt;span style="font-size:12px"&gt;GitHub Actions applies Terraform: network, gateways, database, guardrails, alerts.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1225" width="950" height="40" as="geometry"/></mxCell><mxCell id="c91" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Configure.&lt;/b&gt; &lt;span style="font-size:12px"&gt;It starts the runner, which sets models, teams and keys through the admin service.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1265" width="950" height="40" as="geometry"/></mxCell><mxCell id="c92" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Find.&lt;/b&gt; &lt;span style="font-size:12px"&gt;An app resolves one private name to the nearest healthy region.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1305" width="950" height="40" as="geometry"/></mxCell><mxCell id="c93" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Call.&lt;/b&gt; &lt;span style="font-size:12px"&gt;It sends its key and a model name over HTTPS.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1225" width="950" height="40" as="geometry"/></mxCell><mxCell id="c94" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Check.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Filter, key, budget, limits, then Model Armor on the prompt and the answer.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1265" width="950" height="40" as="geometry"/></mxCell><mxCell id="c95" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Route.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The call runs in the team&amp;#x27;s project and location (purple); its cost is recorded by team.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1305" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2 Many teams" name="2 Many teams"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1240" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;One REST address, many teams&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;Both apps call the same URL with the same request. The key decides everything else.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Orders team's project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;owned by the team&lt;/span&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="400" height="560" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Order reader&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;reads an email, answers JSON&lt;br&gt;Cloud Run, as the team's app identity&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="320" height="125" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="208.0" y="159" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Secret: the team's key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;only the team's app can read it;&lt;br&gt;the runner writes it&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="320" height="90" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12px"&gt;Network&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;its own; peered to the gateway;&lt;br&gt;teams cannot reach each other&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="425" width="320" height="90" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;No model access&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;the app is refused if it calls&lt;br&gt;the model API directly&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="545" width="320" height="85" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="305" as="sourcePoint"/><mxPoint x="230" y="275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:15px&quot;&gt;Support team's project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;owned by the team&lt;/span&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#EEF7F0;strokeColor=#188038;strokeWidth=1.6;fontFam