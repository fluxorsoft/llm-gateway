 value='&lt;b style="font-size:12px"&gt;Task and cap&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;X-Task-Id; calls_per_task&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="456" width="420" height="66" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b style="font-size:12px"&gt;model and tool calls counted per task, a day&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="456" width="600" height="66" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;no task id: 400; over the cap: 429&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="456" width="740" height="66" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="489" as="sourcePoint"/><mxPoint x="1200" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="489" as="sourcePoint"/><mxPoint x="540" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="438" as="sourcePoint"/><mxPoint x="270" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value='&lt;b style="font-size:12px"&gt;Key and team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;LiteLLM&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="420" height="66" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b style="font-size:12px"&gt;the key names the team and its models&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="600" height="66" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style=&quot;font-size:12px&quot;&gt;a wrong or stopped key: 401; another team's model: 403&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="740" height="66" as="geometry"/></mxCell><mxCell id="c39" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="573" as="sourcePoint"/><mxPoint x="1200" y="573" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="573" as="sourcePoint"/><mxPoint x="540" y="573" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="522" as="sourcePoint"/><mxPoint x="270" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value='&lt;b style="font-size:12px"&gt;Budget and limits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;LiteLLM and Redis&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="420" height="66" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style=&quot;font-size:12px&quot;&gt;month's spend; a person's or agent's day; requests and tokens a minute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="624" width="600" height="66" as="geometry"/></mxCell><mxCell id="c44" value='&lt;b style="font-size:12px"&gt;over the limit: 429; over a budget: refused&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="624" width="740" height="66" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="657" as="sourcePoint"/><mxPoint x="1200" y="657" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="657" as="sourcePoint"/><mxPoint x="540" y="657" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="606" as="sourcePoint"/><mxPoint x="270" y="624" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="&lt;b style=&quot;font-size:12px&quot;&gt;Model Armor: prompt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;the team's rule set&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="708" width="420" height="66" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style=&quot;font-size:12px&quot;&gt;in the gateway's own region&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="708" width="600" height="66" as="geometry"/></mxCell><mxCell id="c50" value='&lt;b style="font-size:12px"&gt;a match: 400; no check possible: the call is refused&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="708" width="740" height="66" as="geometry"/></mxCell><mxCell id="c51" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="741" as="sourcePoint"/><mxPoint x="1200" y="741" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="741" as="sourcePoint"/><mxPoint x="540" y="741" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="690" as="sourcePoint"/><mxPoint x="270" y="708" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="&lt;b style=&quot;font-size:12px&quot;&gt;Router&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;the team's project and location&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="792" width="420" height="66" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style=&quot;font-size:12px&quot;&gt;in the file's order&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="792" width="600" height="66" as="geometry"/></mxCell><mxCell id="c56" value='&lt;b style="font-size:12px"&gt;a resting location is skipped&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="792" width="740" height="66" as="geometry"/></mxCell><mxCell id="c57" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="825" as="sourcePoint"/><mxPoint x="1200" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="825" as="sourcePoint"/><mxPoint x="540" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="774" as="sourcePoint"/><mxPoint x="270" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="&lt;b style=&quot;font-size:12px&quot;&gt;Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;as the gateway's identity&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="876" width="420" height="66" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style=&quot;font-size:12px&quot;&gt;predict only, in the team's project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="876" width="600" height="66" as="geometry"/></mxCell><mxCell id="c62" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="909" as="sourcePoint"/><mxPoint x="540" y="909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="858" as="sourcePoint"/><mxPoint x="270" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value='&lt;b style="font-size:12px"&gt;Model Armor: answer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;the whole answer, streamed or not&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="420" height="66" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b style=&quot;font-size:12px&quot;&gt;a streamed answer is held until checked (apps' door)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="960" width="600" height="66" as="geometry"/></mxCell><mxCell id="c66" value='&lt;b style="font-size:12px"&gt;a match: 400&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="960" width="740" height="66" as="geometry"/></mxCell><mxCell id="c67" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="993" as="sourcePoint"/><mxPoint x="1200" y="993" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="993" as="sourcePoint"/><mxPoint x="540" y="993" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="942" as="sourcePoint"/><mxPoint x="270" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value='&lt;b style="font-size:12px"&gt;Usage record&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;team, key, task, agent, person, tool, cost&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1044" width="420" height="66" as="geometry"/></mxCell><mxCell id="c71" value='&lt;b style="font-size:12px"&gt;to logs and BigQuery&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1044" width="600" height="66" as="geometry"/></mxCell><mxCell id="c72" value='&lt;b style="font-size:12px"&gt;never the prompt or the answer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1044" width="740" height="66" as="geometry"/></mxCell><mxCell id="c73" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="1077" as="sourcePoint"/><mxPoint x="1200" y="1077" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="1077" as="sourcePoint"/><mxPoint x="540" y="1077" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="1026" as="sourcePoint"/><mxPoint x="270" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why a filter in front.&lt;/b&gt; &lt;span style="font-size:12px"&gt;LiteLLM accepts a project and a location from the caller; its JWT sign-in is paid.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="950" height="44" as="geometry"/></mxCell><mxCell id="c77" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why not a hook.&lt;/b&gt; &lt;span style="font-size:12px"&gt;LiteLLM changes the request before a hook sees it.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="950" height="44" as="geometry"/></mxCell><mxCell id="c78" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;A blank answer.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Nothing to check: it passes (Model Armor refuses empty text).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1258" width="950" height="44" as="geometry"/></mxCell><mxCell id="c79" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why hold a stream.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Text already sent cannot be taken back; the app gets the checked answer at once.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1170" width="950" height="44" as="geometry"/></mxCell><mxCell id="c80" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Why no prompt logs.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The record is for cost and faults; prompts can hold personal data.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1214" width="950" height="44" as="geometry"/></mxCell><mxCell id="c81" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Tool calls.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Their arguments and answers are checked on the way (page 9).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1258" width="950" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5 Failover" name="5 Failover"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;When something is down&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;Three separate failovers, the upgrade lane, and what was measured on the real deployment.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;THE GATEWAY'S REGION&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="620" height="640" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;Region A&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;readiness fails&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="163.0" y="139" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;Region B&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;takes the traffic&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="250" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="473.0" y="139" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#188038;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="190" as="sourcePoint"/><mxPoint x="370" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Measured (1.0.0):&lt;/b&gt; the database was restarted (35 seconds) with region A barred from it. Traffic moved to region B and back; &lt;b&gt;1 of 379 calls failed&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;A bad release&lt;/b&gt; cannot do this: a revision that is not ready never gets traffic (measured in 1.1.0: a gateway that cannot start; traffic stayed on the last good revision, every check passed).&lt;br&gt;&lt;br&gt;&lt;b&gt;Coupling to know:&lt;/b&gt; a region outside the EU reaches the eu location through the EU region.&lt;br&gt;&lt;br&gt;&lt;b&gt;Limits&lt;/b&gt; are counted in each region's Redis, so 60 a minute can allow 120 across two.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="560" height="430" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;THE MODEL'S LOCATION (CHOSEN PER TEAM)&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="1300" height="640" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:13px"&gt;EU only&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="164" width="160" height="40" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="270" height="92" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;Then&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.8-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="130" width="270" height="92" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="130" width="220" height="92" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="176" as="sourcePoint"/><mxPoint x="1230" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="176" as="sourcePoint"/><mxPoint x="1590" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value='&lt;b style="font-size:13px"&gt;EU, then global&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="279" width="160" height="40" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;eu&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="245" width="270" height="92" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:12px"&gt;Then&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;global&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="245" width="270" height="92" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="245" width="220" height="92" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="291" as="sourcePoint"/><mxPoint x="1230" y="291" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="291" as="sourcePoint"/><mxPoint x="1590" y="291" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value='&lt;b style="font-size:13px"&gt;UK only&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="394" width="160" height="40" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;First&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;gemini-3.5-flash&lt;br&gt;europe-west2&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="360" width="270" height="92" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:12px"&gt;None&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;no second UK location&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="360" width="270" height="92" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Otherwise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;error to the app&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="360" width="220" height="92" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;fails&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="406" as="sourcePoint"/><mxPoint x="1230" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="406" as="sourcePoint"/><mxPoint x="1590" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Measured:&lt;/b&gt; the eu location was cut off. The support team was served from global; the orders team got an error and &lt;b&gt;never left the EU&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;The first call waits&lt;/b&gt; for the model's time limit (45 seconds), then the location rests for two minutes and calls are quick. Set the app's own time limit above that.&lt;br&gt;&lt;br&gt;&lt;b&gt;The alert&lt;/b&gt; opened about four minutes after the first failure.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="705" y="490" width="1250" height="220" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:12px;color:#5F6368"&gt;THE DATABASE (db_replica)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1950" height="300" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b style="font-size:12px"&gt;Copy&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;kept up to date in region B;&lt;br&gt;asynchronous&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="355" height="110" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;db_failover.sh&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;promotes it, moves db.&amp;lt;name&amp;gt;.internal,&lt;br&gt;restarts the gateways: about 6 min&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="445" y="795" width="355" height="110" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="850" as="sourcePoint"/><mxPoint x="445" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value='&lt;b style="font-size:12px"&gt;Plans refuse&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;while the copy is the live database:&lt;br&gt;an apply would replace it&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="795" width="355" height="110" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="850" as="sourcePoint"/><mxPoint x="830" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value='&lt;b style="font-size:12px"&gt;db_failback.sh&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;export, import into the primary, name back,&lt;br&gt;restart, copy deleted: about 6 min&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1215" y="795" width="355" height="110" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="850" as="sourcePoint"/><mxPoint x="1215" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value='&lt;b style="font-size:12px"&gt;apply&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;makes a new copy:&lt;br&gt;about 7.5 min&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1600" y="795" width="355" height="110" as="geometry"/></mxCell><mxCell id="c39" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="850" as="sourcePoint"/><mxPoint x="1600" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Measured in 1.1.0:&lt;/b&gt; both teams' checks passed on the promoted copy and again after the fail-back. Writes not yet copied can be lost (a few seconds of spend). The scripts need gcloud, and jq or Python.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="1900" height="120" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b style="font-size:12px;color:#5F6368"&gt;THE UPGRADE LANE (A NEW LITELLM)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#E6F4F1;strokeColor=#0B6B67;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="1950" height="170" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b style=&quot;font-size:12px&quot;&gt;One region first&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;migration, admin, region B's gateway&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1125" width="440" height="100" as="geometry"/></mxCell><mxCell id="c43" value='&lt;b style="font-size:12px"&gt;The key probe&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;LiteLLM still makes keys our way&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="1125" width="440" height="100" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="1175" as="sourcePoint"/><mxPoint x="540" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="&lt;b style=&quot;font-size:12px&quot;&gt;That region's teams&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;their checks&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="1125" width="440" height="100" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1175" as="sourcePoint"/><mxPoint x="1020" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="&lt;b style=&quot;font-size:12px&quot;&gt;Every region&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;then every team's checks&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="1125" width="440" height="100" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1175" as="sourcePoint"/><mxPoint x="1500" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Try.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The first location.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="950" height="40" as="geometry"/></mxCell><mxCell id="c50" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Rest.&lt;/b&gt; &lt;span style="font-size:12px"&gt;One time-out, or two errors, takes it out for two minutes.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="950" height="40" as="geometry"/></mxCell><mxCell id="c51" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Move.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The next location, then the team&amp;#x27;s other model, inside its residency.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1280" width="950" height="40" as="geometry"/></mxCell><mxCell id="c52" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Tell.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The response shows the fallbacks; an alert tells the central team.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1320" width="950" height="40" as="geometry"/></mxCell><mxCell id="c53" value='&lt;span style="font-size:12px;color:#202124"&gt;Measured: the lane, 1.110.3 to 1.110.2 and back, about 5.5 min for one region and 3 min for the rest; a broken gateway stopped it at the first region with the other untouched.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6 Secrets and identities" name="6 Secrets and identities"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Every secret, every identity, and who may use each&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;&amp;lt;name&amp;gt; is the platform's name (llmgw). No key, password or token is ever in Terraform state, a log or a workflow's output.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:12px;color:#5F6368"&gt;SECRET MANAGER: THE GATEWAY PROJECT&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1950" height="520" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one secret per row;&lt;br&gt;versions kept&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="150" height="110" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="113.0" y="129" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Secret&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="290" height="62" as="geometry"/></mxCell><mxCell id="c7" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Holds&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="390" height="62" as="geometry"/></mxCell><mxCell id="c8" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Written by&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="520" height="62" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Read by&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="120" width="470" height="62" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-database-url&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="182" width="290" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the database's address and password&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="182" width="390" height="62" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-size:12px;color:#202124"&gt;Terraform, write-only: the password is invented in the run, never kept (db_password_round renews it)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="182" width="520" height="62" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-size:12px;color:#202124"&gt;the gateways, the admin service&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="182" width="470" height="62" as="geometry"/></mxCell><mxCell id="c14" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-master-key&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="244" width="290" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;LiteLLM's master key&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="244" width="390" height="62" as="geometry"/></mxCell><mxCell id="c16" value='&lt;span style="font-size:12px;color:#202124"&gt;Terraform, write-only&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="244" width="520" height="62" as="geometry"/></mxCell><mxCell id="c17" value='&lt;span style="font-size:12px;color:#202124"&gt;the gateways, the admin service, the runner&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="244" width="470" height="62" as="geometry"/></mxCell><mxCell id="c18" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-salt-key&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="306" width="290" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;LiteLLM's salt for what it stores&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="306" width="390" height="62" as="geometry"/></mxCell><mxCell id="c20" value='&lt;span style="font-size:12px;color:#202124"&gt;Terraform, write-only&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="306" width="520" height="62" as="geometry"/></mxCell><mxCell id="c21" value='&lt;span style="font-size:12px;color:#202124"&gt;the gateways, the admin service&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="306" width="470" height="62" as="geometry"/></mxCell><mxCell id="c22" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-redis-&amp;lt;region&amp;gt;&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="368" width="290" height="62" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;each region's Redis password&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="368" width="390" height="62" as="geometry"/></mxCell><mxCell id="c24" value='&lt;span style="font-size:12px;color:#202124"&gt;Terraform, from Redis&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="368" width="520" height="62" as="geometry"/></mxCell><mxCell id="c25" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;that region's gateway; the admin service (primary)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="368" width="470" height="62" as="geometry"/></mxCell><mxCell id="c26" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-redis-ca-&amp;lt;region&amp;gt;&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="430" width="290" height="62" as="geometry"/></mxCell><mxCell id="c27" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;each region's Redis certificate&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="430" width="390" height="62" as="geometry"/></mxCell><mxCell id="c28" value='&lt;span style="font-size:12px;color:#202124"&gt;Terraform, from Redis&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="520" height="62" as="geometry"/></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;that region's gateway; the admin service (primary)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="430" width="470" height="62" as="geometry"/></mxCell><mxCell id="c30" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-agents&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="492" width="290" height="62" as="geometry"/></mxCell><mxCell id="c31" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;agents (agents:) each identity's key, team, cap&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="492" width="390" height="62" as="geometry"/></mxCell><mxCell id="c32" value='&lt;span style="font-size:12px;color:#202124"&gt;the key step (runner)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="492" width="520" height="62" as="geometry"/></mxCell><mxCell id="c33" value='&lt;span style="font-size:12px;color:#202124"&gt;the gateways only; the runner, to change it&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="492" width="470" height="62" as="geometry"/></mxCell><mxCell id="c34" value='&lt;span style="font-size:11px;color:#5F6368"&gt;With &lt;b&gt;cmek_keys&lt;/b&gt;, every secret here is encrypted with your own key in each region.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="160" height="330" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;SECRET MANAGER: EACH TEAM'S PROJECT&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="1950" height="330" as="geometry"/></mxCell><mxCell id="c36" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Secret&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="670" width="290" height="62" as="geometry"/></mxCell><mxCell id="c37" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Holds&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="670" width="390" height="62" as="geometry"/></mxCell><mxCell id="c38" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Written by&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="670" width="520" height="62" as="geometry"/></mxCell><mxCell id="c39" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Read by&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="670" width="470" height="62" as="geometry"/></mxCell><mxCell id="c40" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;llm-gateway-key&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="732" width="290" height="62" as="geometry"/></mxCell><mxCell id="c41" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the team's key (the latest version is the current key)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="732" width="390" height="62" as="geometry"/></mxCell><mxCell id="c42" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the key step: LiteLLM makes the value (key_maker: litellm); a removed key's versions are disabled&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="732" width="520" height="62" as="geometry"/></mxCell><mxCell id="c43" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the team's app identity only&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="732" width="470" height="62" as="geometry"/></mxCell><mxCell id="c44" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;llm-key-&amp;lt;handle&amp;gt;&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="794" width="290" height="62" as="geometry"/></mxCell><mxCell id="c45" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a person's own key (members:)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="794" width="390" height="62" as="geometry"/></mxCell><mxCell id="c46" value='&lt;span style="font-size:12px;color:#202124"&gt;the key step&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="794" width="520" height="62" as="geometry"/></mxCell><mxCell id="c47" value='&lt;span style="font-size:12px;color:#202124"&gt;that person only (user:, or serviceAccount: for a shared machine): onedoorai key&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="794" width="470" height="62" as="geometry"/></mxCell><mxCell id="c48" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;(none for agents)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="856" width="290" height="62" as="geometry"/></mxCell><mxCell id="c49" value='&lt;span style="font-size:12px;color:#202124"&gt;an agent signs in with its Google identity&lt;/span&gt;' style="ro