368&quot;&gt;What happens between the app's question and its answer, and what each step refuses.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1950" height="890" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px;color:#5F6368"&gt;STEP&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="420" height="24" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT IT DOES&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="600" height="24" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT IT REFUSES&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="740" height="24" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12px"&gt;App&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;key and model name&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="420" height="66" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;over HTTPS, private address&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="600" height="66" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:12px"&gt;a certificate it does not trust&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="740" height="66" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="153" as="sourcePoint"/><mxPoint x="1200" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="153" as="sourcePoint"/><mxPoint x="540" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;Load balancer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;inference paths only&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=midd