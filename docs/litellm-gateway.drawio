fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="650" as="sourcePoint"/><mxPoint x="760" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;as support&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#188038;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="650" as="sourcePoint"/><mxPoint x="1250" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT A TEAM CANNOT DO (EACH IS A CHECK THAT RUNS AFTER EVERY DEPLOY)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="1950" height="110" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b style=&quot;font-size:12px&quot;&gt;Use another team's model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c67" value='&lt;b style="font-size:12px"&gt;Name another project in its request&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c68" value='&lt;b style="font-size:12px"&gt;Choose another location&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c69" value='&lt;b style="font-size:12px"&gt;Call the model API directly&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c70" value='&lt;b style="font-size:12px"&gt;Reach the admin API or UI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c71" value='&lt;b style="font-size:12px"&gt;Send a blocked prompt&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1650" y="1005" width="300" height="58" as="geometry"/></mxCell><mxCell id="c72" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Join.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A team adds one file: owner, project, residency, models, budget, limits.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="950" height="40" as="geometry"/></mxCell><mxCell id="c73" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Review.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The central team and the project&amp;#x27;s owner approve; the plan checks the rules.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1145" width="950" height="40" as="geometry"/></mxCell><mxCell id="c74" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Use.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The app reads its key from its own project and calls the shared address.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1105" width="950" height="40" as="geometry"/></mxCell><mxCell id="c75" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Pay.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Model usage is on the team&amp;#x27;s own bill; the gateway&amp;#x27;s record shows it by team.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1145" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3 Configure and onboard" name="3 Configure and onboard"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1240" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;What the central team chooses, and what happens with it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;Everything is a reviewed file in the private onboarding repository. Names and values are examples.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CHOOSE (THE ONBOARDING REPOSITORY)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="560" height="1020" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;1. settings/platform.json: the platform&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;{&amp;quot;domain&amp;quot;:&amp;nbsp;&amp;quot;llm.internal.example.com&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;quot;alert_email&amp;quot;:&amp;nbsp;&amp;quot;llm-team@example.com&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;quot;budget_alerts&amp;quot;:&amp;nbsp;true,&amp;nbsp;&amp;quot;spend_log_days&amp;quot;:&amp;nbsp;30,&lt;br&gt;&amp;nbsp;&amp;quot;db_replica&amp;quot;:&amp;nbsp;true,&amp;nbsp;&amp;quot;developer_door&amp;quot;:&amp;nbsp;{...},&lt;br&gt;&amp;nbsp;&amp;quot;audit_record&amp;quot;:&amp;nbsp;{&amp;quot;days&amp;quot;:&amp;nbsp;30},&lt;br&gt;&amp;nbsp;&amp;quot;price_check&amp;quot;:&amp;nbsp;{...},&amp;nbsp;&amp;quot;cmek_keys&amp;quot;:&amp;nbsp;{...},&lt;br&gt;&amp;nbsp;&amp;quot;vpc_sc&amp;quot;:&amp;nbsp;{...},&amp;nbsp;&amp;quot;check_tool_traffic&amp;quot;:&amp;nbsp;true}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="520" height="215" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px"&gt;2. settings/catalogue.yaml: models and rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;schema:&amp;nbsp;2&lt;br&gt;key_maker:&amp;nbsp;litellm&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;LiteLLM&amp;nbsp;picks&amp;nbsp;key&amp;nbsp;values&lt;br&gt;models:&lt;br&gt;&amp;nbsp;&amp;nbsp;gemini-3.5-flash:&amp;nbsp;{locations:&amp;nbsp;[eu,&amp;nbsp;global],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;review_by:&amp;nbsp;2027-02-01}&lt;br&gt;residency:&amp;nbsp;{eu:&amp;nbsp;...,&amp;nbsp;eu-then-global:&amp;nbsp;...}&lt;br&gt;safety:&amp;nbsp;&amp;nbsp;{strict:&amp;nbsp;{injection:&amp;nbsp;LOW_AND_ABOVE}}&lt;br&gt;capture:&amp;nbsp;{approved_teams:&amp;nbsp;[orders]}&lt;br&gt;tools:&amp;nbsp;&amp;nbsp;&amp;nbsp;{gemini-cli:&amp;nbsp;{asks_for:&amp;nbsp;[...]}}&lt;br&gt;tool_servers:&amp;nbsp;{files:&amp;nbsp;{url:&amp;nbsp;...}}&lt;br&gt;provider_tools:&amp;nbsp;{google_search:&amp;nbsp;{...}}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="345" width="520" height="290" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;3. settings/teams/orders.yaml: one per team&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;owner:&amp;nbsp;orders-leads@example.com&lt;br&gt;project:&amp;nbsp;orders-project-id&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;used&amp;nbsp;and&amp;nbsp;billed&lt;br&gt;residency:&amp;nbsp;eu&lt;br&gt;models:&amp;nbsp;{fast:&amp;nbsp;{model:&amp;nbsp;gemini-3.5-flash,&amp;nbsp;...}}&lt;br&gt;budget_monthly_usd:&amp;nbsp;10&lt;br&gt;limits:&amp;nbsp;{rpm:&amp;nbsp;60,&amp;nbsp;tpm:&amp;nbsp;100000}&lt;br&gt;keys:&amp;nbsp;[2]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;rotate.yml&amp;nbsp;adds&amp;nbsp;3,&amp;nbsp;then&amp;nbsp;drops&amp;nbsp;2&lt;br&gt;key_days:&amp;nbsp;30&lt;br&gt;app_service_account:&amp;nbsp;llm-app&lt;br&gt;restart:&amp;nbsp;[{service:&amp;nbsp;orders-app,&amp;nbsp;region:&amp;nbsp;...}]&lt;br&gt;network:&amp;nbsp;{region,&amp;nbsp;cidr}&lt;br&gt;safety:&amp;nbsp;strict&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;capture:&amp;nbsp;{days:&amp;nbsp;30,&amp;nbsp;readers}&lt;br&gt;members:&amp;nbsp;[{id:&amp;nbsp;ann@example.com,&amp;nbsp;daily_usd:&amp;nbsp;5}]&lt;br&gt;agents:&amp;nbsp;&amp;nbsp;[{name:&amp;nbsp;triage,&amp;nbsp;identity:&amp;nbsp;...,&amp;nbsp;...}]&lt;br&gt;tool_servers:&amp;nbsp;{files:&amp;nbsp;[read]}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="520" height="430" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CHECK (THE PLAN STOPS)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="330" height="1020" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;Model not in the catalogue&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;or past its review date&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="115" width="280" height="82" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:12px"&gt;Location outside the residency&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;including any failover&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="212" width="280" height="82" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:12px"&gt;Residency not approved&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;for this team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="309" width="280" height="82" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:12px"&gt;Project used twice&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one project, one team&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="406" width="280" height="82" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;No owner, budget or limits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;or above the maximum&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="503" width="280" height="82" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:12px&quot;&gt;A tool's names outside the team&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;or the name of a model&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="600" width="280" height="82" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;Words kept, not approved&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;capture needs the catalogue&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="697" width="280" height="82" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:12px&quot;&gt;A tool server name with '-'&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;LiteLLM would not start&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="794" width="280" height="82" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12px"&gt;A database copy promoted&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;an apply would replace it&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="891" width="280" height="82" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b style="font-size:12px"&gt;LiteLLM changed by hand&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a daily plan finds it; an alert&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="675" y="988" width="280" height="82" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px;color:#5F6368"&gt;APPLY (GITHUB ACTIONS)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="480" height="1020" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:12px&quot;&gt;Verify and build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;LiteLLM's signature; open source parts only; by digest&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="120" width="430" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:15px&quot;&gt;Step 1: Google&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;applied by GitHub's identity&lt;/span&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="220" width="430" height="380" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:12px"&gt;Platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;network, gateways, database, Model Armor, alerts&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="275" width="380" height="72" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:12px&quot;&gt;Predict-only grant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;for the gateway, in the team's project&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="357" width="380" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:12px&quot;&gt;Secrets, app identity, network&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;in the team's project; peered to the gateway&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="439" width="380" height="72" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;Switches&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;door, copy, perimeter, record, keys, ...&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="521" width="380" height="62" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:15px"&gt;Step 2: LiteLLM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;applied by the runner, inside the network&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="620" width="430" height="460" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Models&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one per team, model and location, with an order&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="675" width="380" height="72" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b style="font-size:12px"&gt;Team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;allowed models, budget, limits, tool servers&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="757" width="380" height="72" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;font-size:12px&quot;&gt;The key step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;keys made by LiteLLM, written only to the&lt;br&gt;team's secret; agents' and people's too&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="839" width="380" height="92" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;font-size:12px&quot;&gt;Then&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;apps listed under restart: restarted;&lt;br&gt;a removed key's secret values disabled;&lt;br&gt;checks as every team&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="941" width="380" height="120" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:12px;color:#5F6368"&gt;USE (THE APP TEAM)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#E6F4F1;strokeColor=#0B6B67;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1580" y="80" width="400" height="1020" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b style="font-size:12px"&gt;Address&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;https://llm.internal.example.com&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="125" width="350" height="90" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;Model name&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;orders-fast&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="235" width="350" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style=&quot;font-size:12px&quot;&gt;Key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;from its own project's secret&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="345" width="350" height="90" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b style="font-size:12px"&gt;Example apps&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;plain REST, streaming or not&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="455" width="350" height="120" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1758.0" y="464" width="44" height="44" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b style="font-size:12px"&gt;The call&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;POST&amp;nbsp;/v1/chat/completions&lt;br&gt;Authorization:&amp;nbsp;Bearer&amp;nbsp;&amp;lt;key&amp;gt;&lt;br&gt;&lt;br&gt;{&amp;quot;model&amp;quot;:&amp;nbsp;&amp;quot;orders-fast&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;quot;messages&amp;quot;:&amp;nbsp;[&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;quot;role&amp;quot;:&amp;nbsp;&amp;quot;user&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;content&amp;quot;:&amp;nbsp;&amp;quot;Hello&amp;quot;}]}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="605" width="350" height="190" as="geometry"/></mxCell><mxCell id="c37" value="&lt;span style=&quot;font-size:12px;color:#5F6368&quot;&gt;Moving a team to another project, model or location changes its file, not its code.&lt;br&gt;&lt;br&gt;A person uses the developers' door with their own key (page 8); an agent signs in with its own Google identity (page 9).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="815" width="350" height="260" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="560" as="sourcePoint"/><mxPoint x="650" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="560" as="sourcePoint"/><mxPoint x="1040" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="560" as="sourcePoint"/><mxPoint x="1580" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Ask.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A team asks; the central team opens a pull request with its file.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1125" width="950" height="40" as="geometry"/></mxCell><mxCell id="c42" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Check.&lt;/b&gt; &lt;span style="font-size:12px"&gt;plan.yml refuses anything outside the rules, and lists every reason.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="950" height="40" as="geometry"/></mxCell><mxCell id="c43" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Approve.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The central team and the project&amp;#x27;s owner approve; the merge deploys.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1125" width="950" height="40" as="geometry"/></mxCell><mxCell id="c44" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Use.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The app reads its key. Removing the file removes the access.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1165" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4 Request and Model Armor" name="4 Request and Model Armor"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1360" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;One request, every check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;What happens between the app's question and its answer, and what each step refuses.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1950" height="1060" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px;color:#5F6368"&gt;STEP&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="420" height="24" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT IT DOES&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="600" height="24" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT IT REFUSES&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="740" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:12px&quot;&gt;App or agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;a key, or an agent's Google ID token&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="420" height="66" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;over HTTPS, private address&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="600" height="66" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:12px"&gt;a certificate it does not trust&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="740" height="66" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="153" as="sourcePoint"/><mxPoint x="1200" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="153" as="sourcePoint"/><mxPoint x="540" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px"&gt;Load balancer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;inference and tool paths only&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="204" width="420" height="66" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;nearest healthy region&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="204" width="600" height="66" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;any other path: 404&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="204" width="740" height="66" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#D93025;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackg