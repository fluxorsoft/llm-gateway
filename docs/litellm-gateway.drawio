<mxfile host="app.diagrams.net"><diagram id="1 Architecture" name="1 Architecture"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1530" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Central LiteLLM gateway on Google Cloud (1.1.0)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;One private address for every team. Two regions, no internet route, every prompt and answer checked, and each team's calls in its own project. Dashed: a switch, off unless set.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:11px"&gt;Built&lt;/b&gt;' style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="20" width="90" height="26" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:11px"&gt;Option&lt;/b&gt;' style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1880" y="20" width="90" height="26" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;TEAM PROJECTS (APPS)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="260" height="600" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;Orders app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;its own project, identity&lt;br&gt;and key&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="220" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="138.0" y="139" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;Support app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;its own project, identity&lt;br&gt;and key&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#188038;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="220" height="120" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="138.0" y="299" width="44" height="44" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:12px"&gt;GKE, VMs, on-premises&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;Shared VPC, peering,&lt;br&gt;VPN or Interconnect&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="220" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;Apps have no access to the model API, so every call passes the gateway's checks.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="220" height="110" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:12px;color:#5F6368"&gt;DELIVERY&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="620" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;Onboarding repository&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;private; settings, catalogue,&lt;br&gt;one file per team; reviewed&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="220" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:12px&quot;&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;the gateway's deploy at a&lt;br&gt;pinned release; keyless&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="910" width="220" height="120" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="138.0" y="919" width="44" height="44" as="geometry"/></mxCell><mxCell id="c16" value='&lt;span style="font-size:11px;color:#5F6368"&gt;Its Google identity works only from main (or the gateway environment where the plan has environments). Weekly: key rotation, release watch, model watch (page 7).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1045" width="220" height="280" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="870" as="sourcePoint"/><mxPoint x="160" y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value='&lt;b style="font-size:15px"&gt;Gateway project&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a network with no route to the internet&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="1150" height="1250" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b style="font-size:12px"&gt;Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one name; the nearest&lt;br&gt;healthy region&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="453.0" y="159" width="44" height="44" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:12px"&gt;Cross-region internal load balancer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;HTTPS; an address in each region;&lt;br&gt;only the inference paths pass&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="440" height="110" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b style="font-size:12px"&gt;Cloud Run service health&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a region whose readiness fails gets no&lt;br&gt;traffic; an unready release never starts&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="320" height="110" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="205" as="sourcePoint"/><mxPoint x="1080" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value='&lt;b style="font-size:15px"&gt;Region A&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;europe-west2, London&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="310" width="530" height="360" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:12px"&gt;LiteLLM gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;request filter, LiteLLM,&lt;br&gt;not root; default URL off&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wra