y="460" as="sourcePoint"/><mxPoint x="640" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value='&lt;b style="font-size:15px"&gt;Region B&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;europe-west1, Belgium&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="310" width="530" height="360" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;LiteLLM gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;request filter, LiteLLM,&lt;br&gt;not root; default URL off&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="360" width="230" height="130" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1038.0" y="369" width="44" height="44" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b style="font-size:12px"&gt;Model Armor&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;prompt and answer&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="360" width="225" height="60" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b style="font-size:12px"&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;limits, cooldowns; TLS, password&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="225" height="60" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="390" as="sourcePoint"/><mxPoint x="1200" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="460" as="sourcePoint"/><mxPoint x="1200" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value='&lt;b style="font-size:12px"&gt;Admin service&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;LiteLLM UI and API;&lt;br&gt;Cloud Run IAM decides who&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="385" y="520" width="230" height="130" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="478.0" y="529" width="44" height="44" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b style="font-size:12px"&gt;Cloud SQL&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;keys, teams, models, spend;&lt;br&gt;private address, backups&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;