px;color:#5F6368"&gt;IDENTITIES (SERVICE ACCOUNTS) AND WHAT EACH MAY DO&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="1950" height="620" as="geometry"/></mxCell><mxCell id="c56" value='&lt;b style="font-size:12px"&gt;IAM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;least privilege:&lt;br&gt;one job each&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="150" height="110" as="geometry"/></mxCell><mxCell id="c57" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="113.0" y="1039" width="44" height="44" as="geometry"/></mxCell><mxCell id="c58" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Identity&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1030" width="290" height="56" as="geometry"/></mxCell><mxCell id="c59" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Used by&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1030" width="420" height="56" as="geometry"/></mxCell><mxCell id="c60" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;May&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1030" width="960" height="56" as="geometry"/></mxCell><mxCell id="c61" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-gateway&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1086" width="290" height="56" as="geometry"/></mxCell><mxCell id="c62" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the gateways, the developers' door&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1086" width="420" height="56" as="geometry"/></mxCell><mxCell id="c63" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;call the model in each team's project (a role with only aiplatform.endpoints.predict); use Model Armor; read its secrets. Nothing else&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1086" width="960" height="56" as="geometry"/></mxCell><mxCell id="c64" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-admin&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1142" width="290" height="56" as="geometry"/></mxCell><mxCell id="c65" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the admin service (LiteLLM's UI and API)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1142" width="420" height="56" as="geometry"/></mxCell><mxCell id="c66" value='&lt;span style="font-size:12px;color:#202124"&gt;read its secrets; no model access. Only admin_members and the runner may call it (Cloud Run IAM)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1142" width="960" height="56" as="geometry"/></mxCell><mxCell id="c67" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-runner&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1198" width="290" height="56" as="geometry"/></mxCell><mxCell id="c68" value='&lt;span style="font-size:12px;color:#202124"&gt;the runner job: settings, the key step, budgets, price check, admin record&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1198" width="420" height="56" as="geometry"/></mxCell><mxCell id="c69" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;call the admin service; write team and person secrets and the agents' map; read usage and billing in BigQuery; write the admin record&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1198" width="960" height="56" as="geometry"/></mxCell><mxCell id="c70" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-scheduler, -budgets, -pricecheck, -audit&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1254" width="290" height="56" as="geometry"/></mxCell><mxCell id="c71" value='&lt;span style="font-size:12px;color:#202124"&gt;Cloud Scheduler&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1254" width="420" height="56" as="geometry"/></mxCell><mxCell id="c72" value='&lt;span style="font-size:12px;color:#202124"&gt;start the runner with one mode, nothing else&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1254" width="960" height="56" as="geometry"/></mxCell><mxCell id="c73" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&amp;lt;name&amp;gt;-github&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1310" width="290" height="56" as="geometry"/></mxCell><mxCell id="c74" value='&lt;span style="font-size:12px;color:#202124"&gt;GitHub Actions (Workload Identity, from main)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1310" width="420" height="56" as="geometry"/></mxCell><mxCell id="c75" value='&lt;span style="font-size:12px;color:#202124"&gt;deploy: roles in the gateway and team projects set by the bootstrap; edit perimeters with VPC_SC_POLICY&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1310" width="960" height="56" as="geometry"/></mxCell><mxCell id="c76" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;llm-app (per team)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1366" width="290" height="56" as="geometry"/></mxCell><mxCell id="c77" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the team's app&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1366" width="420" height="56" as="geometry"/></mxCell><mxCell id="c78" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;read the team's key. The model API refuses it&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1366" width="960" height="56" as="geometry"/></mxCell><mxCell id="c79" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#202124&quot;&gt;an agent's own identity&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1422" width="290" height="56" as="geometry"/></mxCell><mxCell id="c80" value='&lt;span style="font-size:12px;color:#202124"&gt;an agent (agents:)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1422" width="420" height="56" as="geometry"/></mxCell><mxCell id="c81" value='&lt;span style="font-size:12px;color:#202124"&gt;nothing in Google Cloud: its ID token is what the gateway accepts&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1422" width="960" height="56" as="geometry"/></mxCell><mxCell id="c82" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;a member (members:)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1478" width="290" height="56" as="geometry"/></mxCell><mxCell id="c83" value='&lt;span style="font-size:12px;color:#202124"&gt;a person, or their machine&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1478" width="420" height="56" as="geometry"/></mxCell><mxCell id="c84" value='&lt;span style="font-size:12px;color:#202124"&gt;read their own llm-key-&amp;lt;handle&amp;gt;&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1478" width="960" height="56" as="geometry"/></mxCell><mxCell id="c85" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#202124&quot;&gt;Google's service agents&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="1534" width="290" height="56" as="geometry"/></mxCell><mxCell id="c86" value='&lt;span style="font-size:12px;color:#202124"&gt;Cloud SQL, Redis, Secret Manager, BigQuery, Logging&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="1534" width="420" height="56" as="geometry"/></mxCell><mxCell id="c87" value='&lt;span style="font-size:12px;color:#202124"&gt;use your KMS key (cmek_keys); Logging writes usage and kept words to BigQuery&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1534" width="960" height="56" as="geometry"/></mxCell><mxCell id="c88" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Rotate.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A key: rotate.yml (page 7). The database&amp;#x27;s password: raise db_password_round, apply, restart the gateways.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="1900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7 Onboarding and operations" name="7 Onboarding and operations"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1380" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;The onboarding repository, and running it day to day&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;The gateway's code and an organisation's settings live apart. The platform team does onboarding from app teams' requests.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:12px;color:#5F6368"&gt;THE PRIVATE ONBOARDING REPOSITORY&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="620" height="700" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;Its files (made from onboarding/)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;GATEWAY_VERSION&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;v1.1.0&amp;nbsp;(the&amp;nbsp;pinned&amp;nbsp;release)&lt;br&gt;settings/&lt;br&gt;&amp;nbsp;&amp;nbsp;platform.json&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the&amp;nbsp;platform&amp;#x27;s&amp;nbsp;switches&lt;br&gt;&amp;nbsp;&amp;nbsp;catalogue.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;models,&amp;nbsp;rules,&amp;nbsp;tools&lt;br&gt;&amp;nbsp;&amp;nbsp;teams/orders.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one&amp;nbsp;file&amp;nbsp;per&amp;nbsp;team&lt;br&gt;.github/workflows/&lt;br&gt;&amp;nbsp;&amp;nbsp;plan.yml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;deploy.yml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rotate.yml&lt;br&gt;&amp;nbsp;&amp;nbsp;release-watch.yml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;model-watch.yml&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="580" height="340" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;Bootstrap once&lt;/b&gt; (and again for new switches; safe to repeat): APIs, the state bucket, the image repository, the keyless identity, the deployer's roles. CMEK=1 makes Google's service agents; VPC_SC_POLICY= lets it edit perimeters.&lt;br&gt;&lt;br&gt;&lt;b&gt;GitHub Free&lt;/b&gt;: private repositories have no environments, so sign-in works only from main. The organisation and the repository must allow Actions to open pull requests (or give ROTATE_TOKEN, RELEASE_WATCH_TOKEN).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="580" height="300" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;ITS WORKFLOWS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="1290" height="700" as="geometry"/></mxCell><mxCell id="c7" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Workflow&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="120" width="230" height="62" as="geometry"/></mxCell><mxCell id="c8" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;When&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="120" width="230" height="62" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Does&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="120" width="780" height="62" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;plan.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="182" width="230" height="62" as="geometry"/></mxCell><mxCell id="c11" value='&lt;span style="font-size:12px;color:#202124"&gt;every pull request&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="182" width="230" height="62" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-size:12px;color:#202124"&gt;checks the settings against every rule, offline; lists every reason&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="182" width="780" height="62" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;deploy.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="244" width="230" height="62" as="geometry"/></mxCell><mxCell id="c14" value='&lt;span style="font-size:12px;color:#202124"&gt;merge to main, or by hand&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="244" width="230" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the gateway's own deploy at the pinned release: plan, apply, settings, checks, upgrade, destroy&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="244" width="780" height="62" as="geometry"/></mxCell><mxCell id="c16" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;rotate.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="306" width="230" height="62" as="geometry"/></mxCell><mxCell id="c17" value='&lt;span style="font-size:12px;color:#202124"&gt;Mondays, or now: (a key that leaked)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="306" width="230" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a pull request for each team's next key step; checks the rules itself&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="306" width="780" height="62" as="geometry"/></mxCell><mxCell id="c19" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;release-watch.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="368" width="230" height="62" as="geometry"/></mxCell><mxCell id="c20" value='&lt;span style="font-size:12px;color:#202124"&gt;Mondays&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="368" width="230" height="62" as="geometry"/></mxCell><mxCell id="c21" value='&lt;span style="font-size:12px;color:#202124"&gt;an issue when a newer release is out (a pull request with RELEASE_WATCH_TOKEN)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="368" width="780" height="62" as="geometry"/></mxCell><mxCell id="c22" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;model-watch.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="430" width="230" height="62" as="geometry"/></mxCell><mxCell id="c23" value='&lt;span style="font-size:12px;color:#202124"&gt;Mondays&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945" y="430" width="230" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;an issue a month before a model's review_by, naming the teams that use it&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="430" width="780" height="62" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b style="font-size:15px"&gt;Key rotation (measured)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="530" width="1240" height="230" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&quot;font-size:12px&quot;&gt;keys: [2] -&gt; [2, 3]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;rotate.yml's pull request&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="590" width="270" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b style="font-size:12px"&gt;deploy&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;LiteLLM makes orders-3;&lt;br&gt;written to the secret&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="590" width="270" height="150" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="665" as="sourcePoint"/><mxPoint x="1040" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b style=&quot;font-size:12px&quot;&gt;restart:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;the team's apps read it&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="590" width="270" height="150" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="665" as="sourcePoint"/><mxPoint x="1340" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value='&lt;b style="font-size:12px"&gt;keys: [3]&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;next step: orders-2 deleted,&lt;br&gt;its value disabled&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="590" width="270" height="150" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="665" as="sourcePoint"/><mxPoint x="1640" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT RUNS ON ITS OWN (CLOUD SCHEDULER STARTS THE RUNNER)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#E6F4F1;strokeColor=#0B6B67;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1950" height="380" as="geometry"/></mxCell><mxCell id="c34" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Mode&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="330" height="52" as="geometry"/></mxCell><mxCell id="c35" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;When&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="250" height="52" as="geometry"/></mxCell><mxCell id="c36" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Does&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="850" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c37" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;drift&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="330" height="52" as="geometry"/></mxCell><mxCell id="c38" value='&lt;span style="font-size:12px;color:#202124"&gt;daily 06:00&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="902" width="250" height="52" as="geometry"/></mxCell><mxCell id="c39" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;plans LiteLLM's settings: a change made by hand is an alert&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="902" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c40" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;budgets (budget_alerts)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="954" width="330" height="52" as="geometry"/></mxCell><mxCell id="c41" value='&lt;span style="font-size:12px;color:#202124"&gt;hourly&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="954" width="250" height="52" as="geometry"/></mxCell><mxCell id="c42" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;each team's spend against its budget: alerts at 80 and 100 per cent to the owner and the platform team&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="954" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c43" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;pricecheck (price_check)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1006" width="330" height="52" as="geometry"/></mxCell><mxCell id="c44" value='&lt;span style="font-size:12px;color:#202124"&gt;Mondays 07:00&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="1006" width="250" height="52" as="geometry"/></mxCell><mxCell id="c45" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;last week's gateway cost per team project against the billing export: an alert above 10 per cent&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="1006" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c46" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;audit (audit_record)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1058" width="330" height="52" as="geometry"/></mxCell><mxCell id="c47" value='&lt;span style="font-size:12px;color:#202124"&gt;daily 05:30&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="1058" width="250" height="52" as="geometry"/></mxCell><mxCell id="c48" value='&lt;span style="font-size:12px;color:#202124"&gt;what LiteLLM is set to, chained to the day before, into a bucket nobody can change&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="1058" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c49" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;retention (spend_log_days)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="330" height="52" as="geometry"/></mxCell><mxCell id="c50" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;LiteLLM's own job&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="1110" width="250" height="52" as="geometry"/></mxCell><mxCell id="c51" value='&lt;span style="font-size:12px;color:#202124"&gt;old spend rows removed; the usage record in BigQuery keeps everything&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="1110" width="1310" height="52" as="geometry"/></mxCell><mxCell id="c52" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Ask.&lt;/b&gt; &lt;span style="font-size:12px"&gt;An app team asks for access, a model, a person or an agent.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="950" height="40" as="geometry"/></mxCell><mxCell id="c53" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Write.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The platform team opens a pull request with the change.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="950" height="40" as="geometry"/></mxCell><mxCell id="c54" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Check.&lt;/b&gt; &lt;span style="font-size:12px"&gt;plan.yml lists anything outside the rules.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1220" width="950" height="40" as="geometry"/></mxCell><mxCell id="c55" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Merge.&lt;/b&gt; &lt;span style="font-size:12px"&gt;deploy.yml applies it, restarts apps whose keys changed, runs every team&amp;#x27;s checks.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1260" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8 The developers' door" name="8 The developers' door"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1260" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Coding tools through the gateway (developer_door)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;A second door beside the apps' one: the same image and settings, answers as they come, the APIs coding tools speak.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;A DEVELOPER'S MACHINE (IN THE NETWORK)&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="560" height="560" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;Codex CLI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;Responses API&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="240" height="110" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px"&gt;Gemini CLI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;Gemini API&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="125" width="240" height="110" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px"&gt;The key, without typing it&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;pip&amp;nbsp;install&amp;nbsp;onedoorai&lt;br&gt;export&amp;nbsp;LLM_KEY=$(onedoorai&amp;nbsp;key&amp;nbsp;\&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--project&amp;nbsp;eng-project)&lt;br&gt;export&amp;nbsp;GEMINI_API_KEY=$LLM_KEY&lt;br&gt;&lt;br&gt;onedoorai&amp;nbsp;spend&amp;nbsp;--door&amp;nbsp;\&lt;br&gt;&amp;nbsp;&amp;nbsp;https://dev.llm.internal.example.com&amp;nbsp;\&lt;br&gt;&amp;nbsp;&amp;nbsp;--project&amp;nbsp;eng-project&lt;br&gt;#&amp;nbsp;eng.ann:&amp;nbsp;spent&amp;nbsp;1.2040&amp;nbsp;USD&amp;nbsp;of&amp;nbsp;5.00&amp;nbsp;a&amp;nbsp;day&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="500" height="360" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:15px"&gt;THE GATEWAY PROJECT&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;dev.&amp;lt;domain&amp;gt;: the same load balancer, its own paths&lt;/span&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F4FBFA;strokeColor=#0B6B67;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="840" height="560" as="geometry"/></mxCell><mxCell id="c8" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Path&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="140" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;For&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="995" y="140" width="460" height="50" as="geometry"/></mxCell><mxCell id="c10" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;/v1/responses&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="190" width="330" height="50" as="geometry"/></mxCell><mxCell id="c11" value='&lt;span style="font-size:12px;color:#202124"&gt;Codex CLI (whole and streamed)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="995" y="190" width="460" height="50" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;/v1beta/models/*&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="240" width="330" height="50" as="geometry"/></mxCell><mxCell id="c13" value='&lt;span style="font-size:12px;color:#202124"&gt;Gemini CLI (generateContent, streamGenerateContent)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="995" y="240" width="460" height="50" as="geometry"/></mxCell><mxCell id="c14" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;/v1/chat/completions, /v1/models&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="290" width="330" height="50" as="geometry"/></mxCell><mxCell id="c15" value='&lt;span style="font-size:12px;color:#202124"&gt;anything OpenAI-shaped&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="995" y="290" width="460" height="50" as="geometry"/></mxCell><mxCell id="c16" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;/key/info&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="340" width="330" height="50" as="geometry"/></mxCell><mxCell id="c17" value='&lt;span style="font-size:12px;color:#202124"&gt;onedoorai spend: only the asking key&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="995" y="340" width="460" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:12px&quot;&gt;Developers' door&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;Cloud Run in both regions; one copy always&lt;br&gt;on in the primary, the other on demand&lt;br&gt;(always_on: primary, all or none)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665" y="420" width="380" height="200" as="geometry"/></mxCell><mxCell id="c19" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="833.0" y="429" width="44" height="44" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:12px&quot;&gt;Checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;every question whole with the team's Model&lt;br&gt;Armor rules; answers not held;&lt;br&gt;refused: pictures, files, the provider's&lt;br&gt;tools (web search), other teams' models&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="385" height="200" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;IN THE TEAM'S PROJECT&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="80" width="460" height="560" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:12px&quot;&gt;llm-key-&amp;lt;handle&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;a person's own key; only they can read it&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1545" y="125" width="410" height="120" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1728.0" y="134" width="44" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:12px&quot;&gt;The team's file&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;member_monthly_usd:&amp;nbsp;30&lt;br&gt;members:&lt;br&gt;&amp;nbsp;&amp;nbsp;-&amp;nbsp;{id:&amp;nbsp;ann@example.com,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;daily_usd:&amp;nbsp;5}&lt;br&gt;developer_tools:&amp;nbsp;[gemini-cli,&amp;nbsp;codex]&lt;br&gt;tool_models:&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;names&amp;nbsp;tools&amp;nbsp;ask&amp;nbsp;for&lt;br&gt;&amp;nbsp;&amp;nbsp;gemini-3.8-flash:&amp;nbsp;code&lt;br&gt;&amp;nbsp;&amp;nbsp;gemini-3.5-flash:&amp;nbsp;code&lt;/font&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1545" y="265" width="410" height="355" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.4;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="190" as="sourcePoint"/><mxPoint x="655" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="&lt;span style=&quot;font-size:10px;color:#5F6368&quot;&gt;HTTPS, the person's key&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="556" y="196" width="100" height="60" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT IS SET, AND WHAT WAS MEASURED&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFF8F0;strokeColor=#B45309;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1950" height="380" as="geometry"/></mxCell><mxCell id="c28" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="420" height="52" as="geometry"/></mxCell><mxCell id="c29" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;In 1.1.0&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c30" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#202124&quot;&gt;A person's limits&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="772" width="420" height="52" as="geometry"/></mxCell><mxCell id="c31" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;each person's key has the team's member budget and their own daily_usd: at the limit, 422 on every API; others carry on&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="772" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style=&quot;font-size:12px;font-weight:bold;color:#202124&quot;&gt;The tools' model names&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="824" width="420" height="52" as="geometry"/></mxCell><mxCell id="c33" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;on the team (Responses, chat) and on each person's key (LiteLLM's Gemini route applies only a key's names)&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="824" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c34" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Usage&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="876" width="420" height="52" as="geometry"/></mxCell><mxCell id="c35" value='&lt;span style="font-size:12px;color:#202124"&gt;every call in the usage record, by person; a fix keeps the record when a client closes a stream first (6 of 6 streamed Gemini calls)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="876" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c36" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Speed&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="928" width="420" height="52" as="geometry"/></mxCell><mxCell id="c37" value='&lt;span style="font-size:12px;color:#202124"&gt;first words 2.2 to 3.8 s (Gemini, Responses); a region starting on demand: about a minute for the first call (71 s), then 1.9 s&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="928" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c38" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Proven with&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="420" height="52" as="geometry"/></mxCell><mxCell id="c39" value='&lt;span style="font-size:12px;color:#202124"&gt;Codex CLI 0.172 and Gemini CLI 0.71 against Gemini on Vertex AI; Claude Code is not part of 1.1.0&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="980" width="1470" height="52" as="geometry"/></mxCell><mxCell id="c40" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Turn on.&lt;/b&gt; &lt;span style="font-size:12px"&gt;developer_door in the platform&amp;#x27;s settings; the tools in the catalogue.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="950" height="40" as="geometry"/></mxCell><mxCell id="c41" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Add people.&lt;/b&gt; &lt;span style="font-size:12px"&gt;members: in the team&amp;#x27;s file, and the tools&amp;#x27; model names.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="950" height="40" as="geometry"/></mxCell><mxCell id="c42" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Install.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The tools with the door&amp;#x27;s address, from the company&amp;#x27;s software catalogue.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1090" width="950" height="40" as="geometry"/></mxCell><mxCell id="c43" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Use.&lt;/b&gt; &lt;span style="font-size:12px"&gt;onedoorai key at the start of a session; onedoorai spend any time.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="1130" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="9 Agents and tools" name="9 Agents and tools"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1400" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;Agents with their own identity, and tools on the way&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;The gateway is where an agent is seen and stopped. What a tool may do stays with the tool.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;AN AGENT'S CALL&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FBFF;strokeColor=#4285F4;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1950" height="380" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px"&gt;The agent&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;its own service account;&lt;br&gt;a Google ID token,&lt;br&gt;audience: the gateway&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="213.0" y="134" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Request filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;checks Google's signature,&lt;br&gt;issuer, audience, expiry&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D93025;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="445" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="200" as="sourcePoint"/><mxPoint x="445" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value='&lt;b style="font-size:12px"&gt;&amp;lt;name&amp;gt;-agents&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;identity to key: a secret&lt;br&gt;only the gateway reads&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="983.0" y="134" width="44" height="44" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="200" as="sourcePoint"/><mxPoint x="830" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:12px&quot;&gt;The agent's key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;&amp;lt;team&amp;gt;~&amp;lt;name&amp;gt;: its budget,&lt;br&gt;limits, stop switch&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1215" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="200" as="sourcePoint"/><mxPoint x="1215" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value='&lt;b style="font-size:12px"&gt;LiteLLM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;as for any key; the record&lt;br&gt;names agent, task, person&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B6B67;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1600" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1753.0" y="134" width="44" height="44" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B6B67;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1565" y="200" as="sourcePoint"/><mxPoint x="1600" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;&lt;b&gt;X-Task-Id&lt;/b&gt; (1 to 64 letters, digits and . _ : -) goes into the usage record: a task's cost is one line. &lt;b&gt;calls_per_task&lt;/b&gt; counts an agent's model and tool calls per task for a day (not a tool session's set-up): the next is 429. &lt;b&gt;X-Acting-For&lt;/b&gt; takes a signed Google token of the person; the record names them. &lt;b&gt;stopped: true&lt;/b&gt; blocks the key: measured 2 s and 27 s after the key step in the two regions. An identity that is no agent: 401.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="1900" height="150" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b style="font-size:12px;color:#5F6368"&gt;TOOL SERVERS (MCP)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3EEFA;strokeColor=#6B3FA0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="1150" height="560" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;Granted in the settings&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;#&amp;nbsp;catalogue.yaml&lt;br&gt;tool_servers:&lt;br&gt;&amp;nbsp;&amp;nbsp;files:&amp;nbsp;{url:&amp;nbsp;https://.../mcp}&lt;br&gt;#&amp;nbsp;teams/eng.yaml&lt;br&gt;tool_servers:&amp;nbsp;{files:&amp;nbsp;[read,&amp;nbsp;list]}&lt;br&gt;agents:&lt;br&gt;&amp;nbsp;&amp;nbsp;-&amp;nbsp;{name:&amp;nbsp;triage,&amp;nbsp;...,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tools:&amp;nbsp;{files:&amp;nbsp;[read]}}&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="520" height="300" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:12px&quot;&gt;/mcp on the gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;a key sees no server without its own grant: the key step&lt;br&gt;gives team keys the team's tools, each agent only its own&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="530" width="560" height="140" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:12px&quot;&gt;check_tool_traffic&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;Model Armor reads a call's name and arguments before it goes on,&lt;br&gt;and holds the tool's answer until read: about 0.36 s a call&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="560" height="140" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:12px&quot;&gt;A tool server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;yours, on Cloud Run, internal only; the gateway&lt;br&gt;never passes a caller's credentials to it&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="850" width="520" height="180" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="288.0" y="859" width="44" height="44" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="760" as="sourcePoint"/><mxPoint x="570" y="940" as="targetPoint"/><Array as="points"><mxPoint x="585" y="760"/><mxPoint x="585" y="940"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;Measured: the team saw its two tools, the agent only its one; a tool granted to nobody, refused; an injection in an argument and in an answer, refused. A server's name cannot contain '-'.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="850" width="560" height="180" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:12px;color:#5F6368&quot;&gt;THE PROVIDER'S OWN TOOLS&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FDECEA;strokeColor=#D93025;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="490" width="760" height="560" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Refused unless listed and asked for&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;#&amp;nbsp;catalogue.yaml&lt;br&gt;provider_tools:&lt;br&gt;&amp;nbsp;&amp;nbsp;google_search:&amp;nbsp;{reason:&amp;nbsp;...,&amp;nbsp;residency:&amp;nbsp;...,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;price:&amp;nbsp;...}&lt;br&gt;#&amp;nbsp;teams/news.yaml&lt;br&gt;provider_tools:&amp;nbsp;[google_search]&lt;/font&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1245" y="530" width="710" height="250" as="geometry"/></mxCell><mxCell id="c27" value='&lt;span style="font-size:12px;color:#202124"&gt;Web search and running code act outside the network. Names: google_search, url_context, code_execution. Measured: a grounded answer for the team that asked; every other team refused (400).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1245" y="800" width="710" height="230" as="geometry"/></mxCell><mxCell id="c28" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Give an agent an identity.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A service account in the team&amp;#x27;s project; agents: in the team&amp;#x27;s file.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1900" height="44" as="geometry"/></mxCell><mxCell id="c29" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Grant its tools.&lt;/b&gt; &lt;span style="font-size:12px"&gt;tools: within the team&amp;#x27;s tool_servers; calls_per_task if each task should be capped.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1124" width="1900" height="44" as="geometry"/></mxCell><mxCell id="c30" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Stop it.&lt;/b&gt; &lt;span style="font-size:12px"&gt;stopped: true, merged: its key is blocked in every region; false starts it again.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1168" width="1900" height="44" as="geometry"/></mxCell><mxCell id="c31" value='&lt;span style="font-size:12px;color:#5F6368"&gt;Not in 1.1.0: agents calling agents (A2A). Each agent still calls the gateway with its own identity, so it is counted.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="1900" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="10 Governance" name="10 Governance"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="880" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Governance switches&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F6368&quot;&gt;Each is off unless set, and each is built from Google Cloud and LiteLLM's free parts.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Switch&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="330" height="72" as="geometry"/></mxCell><mxCell id="c4" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;What it builds&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="980" height="72" as="geometry"/></mxCell><mxCell id="c5" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;Measured in the 1.1.0 test&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1F3F4;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="640" height="72" as="geometry"/></mxCell><mxCell id="c6" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;safety: (catalogue and team)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="330" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a Model Armor template per rule set and region; the guardrail picks the caller's team's template, questions and answers&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="162" width="980" height="72" as="geometry"/></mxCell><mxCell id="c8" value='&lt;span style="font-size:12px;color:#202124"&gt;a stricter team refused what the other team may send&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="162" width="640" height="72" as="geometry"/></mxCell><mxCell id="c9" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;capture: (approved teams)&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="330" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a log sink to llm_words in the team's own project (the gateway's primary region), deleted after days, readable by its readers; kept out of the gateway's logs&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="234" width="980" height="72" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;the team's questions and answers there; none for others; none in any project's logs&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="234" width="640" height="72" as="geometry"/></mxCell><mxCell id="c12" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;audit_record&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="306" width="330" height="72" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a daily record of LiteLLM's settings (never a key's value) in a bucket with a retention policy; each carries the previous one's digest; lock: true for good&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="306" width="980" height="72" as="geometry"/></mxCell><mxCell id="c14" value='&lt;span style="font-size:12px;color:#202124"&gt;two records chained; a delete refused, even for the owner&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="306" width="640" height="72" as="geometry"/></mxCell><mxCell id="c15" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;vpc_sc&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="330" height="72" as="geometry"/></mxCell><mxCell id="c16" value='&lt;span style="font-size:12px;color:#202124"&gt;a VPC Service Controls perimeter round the gateway and every team project; dry run first, then enforce; identities that may come in&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="378" width="980" height="72" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;dry run: only a laptop and the apps' direct model calls; enforced: every check passed&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="378" width="640" height="72" as="geometry"/></mxCell><mxCell id="c18" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;cmek_keys&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="330" height="72" as="geometry"/></mxCell><mxCell id="c19" value='&lt;span style="font-size:12px;color:#202124"&gt;your own KMS key in each region for the database and its copy, Redis, every gateway secret and the usage dataset&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="450" width="980" height="72" as="geometry"/></mxCell><mxCell id="c20" value='&lt;span style="font-size:12px;color:#202124"&gt;a fresh install: all of them on the key; LiteLLM ran on it&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="450" width="640" height="72" as="geometry"/></mxCell><mxCell id="c21" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;budget_alerts, price_check&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="330" height="72" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;alerts at 80 and 100 per cent of a team's budget; the gateway's cost against the bill each week&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="522" width="980" height="72" as="geometry"/></mxCell><mxCell id="c23" value='&lt;span style="font-size:12px;color:#202124"&gt;an alert at 100; a 43.5 per cent drift alert&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="522" width="640" height="72" as="geometry"/></mxCell><mxCell id="c24" value='&lt;span style="font-size:12px;font-weight:bold;color:#202124"&gt;review_by, model-watch.yml&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="594" width="330" height="72" as="geometry"/></mxCell><mxCell id="c25" value="&lt;span style=&quot;font-size:12px;color:#202124&quot;&gt;a plan stops after a model's date; an issue a month before, naming its teams&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="594" width="980" height="72" as="geometry"/></mxCell><mxCell id="c26" value='&lt;span style="font-size:12px;color:#202124"&gt;an issue for a model 16 days from its date&lt;/span&gt;' style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="594" width="640" height="72" as="geometry"/></mxCell><mxCell id="c27" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Start with the defaults.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Every switch is off: a 1.0.0 install upgrades with no change.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="950" height="40" as="geometry"/></mxCell><mxCell id="c28" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Turn one on at a time.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Run the bootstrap again first; then plan and read it.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="950" height="40" as="geometry"/></mxCell><mxCell id="c29" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Prove it.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Each team&amp;#x27;s checks run after every deploy.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="700" width="950" height="40" as="geometry"/></mxCell><mxCell id="c30" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Read the docs.&lt;/b&gt; &lt;span style="font-size:12px"&gt;docs/GOVERNANCE.md says what each switch needs and costs.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="950" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
