keColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="760" width="400" height="420" as="geometry"/></mxCell><mxCell id="c82" value='&lt;span style="font-size:12px;color:#202124"&gt;&lt;b&gt;Project&lt;/b&gt;: where calls run and are billed&lt;br&gt;&lt;br&gt;&lt;b&gt;Residency&lt;/b&gt;: eu unless approved otherwise&lt;br&gt;&lt;br&gt;&lt;b&gt;Models&lt;/b&gt; and their &lt;b&gt;locations&lt;/b&gt;, in order&lt;br&gt;&lt;br&gt;&lt;b&gt;Fallback&lt;/b&gt;: another model of the team&lt;br&gt;&lt;br&gt;&lt;b&gt;Budget&lt;/b&gt;, &lt;b&gt;limits&lt;/b&gt; and &lt;b&gt;key life&lt;/b&gt;&lt;br&gt;&lt;br&gt;The plan refuses anything outside the catalogue.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1575" y="815" width="370" height="350" as="geometry"/></mxCell><mxCell id="c83" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="780" as="sourcePoint"/><mxPoint x="1640" y="247" as="targetPoint"/><Array as="points"><mxPoint x="1505" y="780"/><mxPoint x="1505" y="247"/></Array></mxGeometry></mxCell><mxCell id="c84" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6B3FA0;strokeWidth=2.2;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1505" y="457" as="sourcePoint"/><mxPoint x="1640" y="457" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#20